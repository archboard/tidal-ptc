---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Base name in src/assets/screenshots, without -light/-dark.png. A plain <name>.png serves both themes. */
  name: string;
  alt: string;
  caption?: string;
}

const { name, alt, caption } = Astro.props;
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/*.png', { eager: true });
const single = shots[`../assets/screenshots/${name}.png`]?.default;
const light = shots[`../assets/screenshots/${name}-light.png`]?.default ?? single;
const dark = shots[`../assets/screenshots/${name}-dark.png`]?.default ?? single;
---

<figure class="screenshot not-content">
  {light && dark ? (
    <>
      <Image class="light-only" src={light} alt={alt} widths={[720, 1440, 2880]} sizes="(min-width: 72rem) 48rem, 100vw" />
      <Image class="dark-only" src={dark} alt={alt} widths={[720, 1440, 2880]} sizes="(min-width: 72rem) 48rem, 100vw" />
    </>
  ) : (
    // ponytail: placeholder until `npm run screenshots` has produced this name
    <div class="missing" role="img" aria-label={alt}>Screenshot coming soon: {name}</div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screenshot {
    margin-block: 1.5rem;
  }
  .screenshot :global(img),
  .missing {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-hairline-light);
  }
  .missing {
    aspect-ratio: 16 / 10;
    display: grid;
    place-items: center;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    background: var(--sl-color-gray-6);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  :global([data-theme='light']) .dark-only,
  :global([data-theme='dark']) .light-only {
    display: none;
  }
</style>
